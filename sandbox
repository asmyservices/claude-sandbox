#!/usr/bin/env python3
import sys
from pathlib import Path

if sys.version_info < (3, 8):
    sys.exit("sandbox needs Python 3.8 or newer")

sys.path.insert(0, str(Path(__file__).resolve().parent))

try:
    import yaml  # noqa: F401
except ImportError:
    sys.exit("sandbox needs PyYAML: apt install python3-yaml (or pip install --user pyyaml)")

from sandboxlib.cli import main

sys.exit(main())
